version: "3.9"

services:
  mongo:
    image: mongo:7
    container_name: ie-umip-mongo
    ports:
      - "27017:27017"
    restart: unless-stopped
    networks: [umip-net]

  redis:
    image: redis:7
    container_name: ie-umip-redis
    command: ["redis-server", "--appendonly", "yes"]
    ports:
      - "6379:6379"
    restart: unless-stopped
    networks: [umip-net]

  intent-gateway:
    build: ./services/intent-gateway
    container_name: ie-umip-intent-gateway
    depends_on:
      - mongo
      - redis
    environment:
      PORT: 8080
      REDIS_URL: redis://redis:6379
      MONGO_URL: mongodb://mongo:27017/umip
    ports:
      - "8080:8080"
    restart: unless-stopped
    networks: [umip-net]

  doctor-ui:
    build: ./apps/doctor-ui
    container_name: ie-umip-doctor-ui
    depends_on:
      - intent-gateway
    environment:
      VITE_API_URL: http://intent-gateway:8080
    ports:
      - "3001:3000"
    restart: unless-stopped
    networks: [umip-net]

  patient-ui:
    build: ./apps/patient-ui
    container_name: ie-umip-patient-ui
    depends_on:
      - intent-gateway
    environment:
      VITE_API_URL: http://intent-gateway:8080
    ports:
      - "3002:3000"
    restart: unless-stopped
    networks: [umip-net]

  

pharmacy-ui:
  build: ./apps/pharmacy-ui
  container_name: ie-umip-pharmacy-ui
  depends_on:
    - intent-gateway
  ports:
    - "3003:3000"
  environment:
    VITE_API_URL: http://intent-gateway:8080
  restart: unless-stopped



  insurance-ui:
    build: ./apps/insurance-ui
    container_name: ie-umip-insurance-ui
    depends_on:
      - intent-gateway
    environment:
      VITE_API_URL: http://intent-gateway:8080
    ports:
      - "3004:3000"
    restart: unless-stopped
    networks: [umip-net]

  pharmacy-gateway:
    build: ./services/pharmacy-gateway
    container_name: ie-umip-pharmacy-gateway
    depends_on:
      - mongo
      - redis
    environment:
      PORT: 8093
      MONGO_URL: mongodb://mongo:27017/umip
      REDIS_URL: redis://redis:6379
    ports:
      - "8093:8093"
    restart: unless-stopped
    networks: [umip-net]

  ddi-engine:
    build: ./services/ddi-engine
    container_name: ie-umip-ddi-engine
    environment:
      PORT: 8092
    ports:
      - "8092:8092"
    restart: unless-stopped
    networks: [umip-net]

  grafana:
    image: grafana/grafana:10.4.1
    container_name: ie-umip-grafana
    ports:
      - "3000:3000"
    volumes:
      - ./dashboards:/var/lib/grafana/dashboards
      - ./grafana/provisioning:/etc/grafana/provisioning
    environment:
      GF_SECURITY_ADMIN_PASSWORD: admin
    restart: unless-stopped
    networks: [umip-net]

networks:
  umip-net:
    driver: bridge
